{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ahpv/annotation/1.0",
  "title": "Manual region-of-interest annotation (current state of one record)",
  "description": "A display/data artifact only. The closed property set means no steering offset, aim point or command can be represented.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "annotation_id", "revision", "session_id", "frame_id", "source_timestamp_ns", "timestamp_basis",
               "annotator_id", "annotation_type", "region_xywh_pixels", "coordinate_space", "image_size_pixels", "review_status",
               "reviewer_id", "review_comment", "notes", "created_at", "updated_at", "last_modified_by", "deleted"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "annotation_id": {"type": "string", "pattern": "^a-[0-9a-f]{16}$"},
    "revision": {"type": "integer", "minimum": 1},
    "session_id": {"type": "string", "pattern": "^s-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "frame_id": {"type": "integer", "minimum": 0},
    "source_timestamp_ns": {"type": "integer"},
    "timestamp_basis": {"type": "string"},
    "annotator_id": {"$ref": "#/$defs/principal"},
    "annotation_type": {"const": "manual_region_of_interest"},
    "region_xywh_pixels": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4},
    "coordinate_space": {"const": "source_pixels_origin_top_left"},
    "image_size_pixels": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
    "review_status": {"enum": ["unreviewed", "accepted", "rejected", "needs_revision"]},
    "reviewer_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/principal"}]},
    "review_comment": {"type": ["null", "string"], "maxLength": 500},
    "notes": {"type": "string", "maxLength": 500},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "last_modified_by": {"$ref": "#/$defs/principal"},
    "deleted": {"type": "boolean"},
    "deletion_reason": {"type": "string", "maxLength": 500}
  },
  "$defs": {"principal": {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,63}$"}}
}
